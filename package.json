    "nodemailer":      "6.9.14",
    "react":           "18.3.1",
    "react-dom":       "18.3.1",
    "zod":             "3.23.8"
  },
  "devDependencies": {
    "@types/node":      "20.14.11",
    "@types/nodemailer":"6.4.15",
    "@types/react":     "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer":     "10.4.19",
    "eslint":           "8.57.0",
    "eslint-config-next":"14.2.5",
    "postcss":          "8.4.39",
    "prisma":           "5.16.1",
    "tailwindcss":      "3.4.6",
