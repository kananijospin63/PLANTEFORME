# ============================================================
# CLUB AI — Backend — Variables d'environnement
# ============================================================
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne JAMAIS commiter .env.local dans git.
# ============================================================

# ── Base de données ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jovim_tech"

# ── Make Webhook ─────────────────────────────────────────────
# Obtenir l'URL dans Make : Scenario > Webhooks > Add webhook
# Format : https://hook.eu1.make.com/XXXXXXXXXXXXXXXXXXXX

# Scénario 1 — accusé de réception (déclenché à l'inscription)
MAKE_WEBHOOK_URL=

# Scénario 2 — confirmation (déclenché par la validation admin)
MAKE_WEBHOOK_VALIDATION_URL=

# ── Gemini AI ────────────────────────────────────────────────
# Obtenir la clé sur : https://aistudio.google.com/app/apikey
# Utilisé dans Make (module HTTP ou Gemini natif)
GEMINI_API_KEY=

# ── Google Sheets ────────────────────────────────────────────
# ID du Google Sheet (dans l'URL : /spreadsheets/d/ID/edit)
GOOGLE_SHEET_ID=

# ── WhatsApp Groupes ─────────────────────────────────────────
# Liens d'invitation des groupes WhatsApp par formation
# Format : https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXX
WHATSAPP_GROUP_CHATGPT=
WHATSAPP_GROUP_N8N=
WHATSAPP_GROUP_ENTREPRENEURS=
WHATSAPP_GROUP_DEV=
WHATSAPP_GROUP_GENERAL=

# ── Email / SMTP (optionnel - si envoi direct sans Make) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clubai@gmail.com
SMTP_PASS=
SMTP_FROM="CLUB AI <clubai@gmail.com>"

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# ── Sécurité Webhook entrant ──────────────────────────────────
# Secret pour valider les webhooks entrants depuis Make
WEBHOOK_SECRET=
